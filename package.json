{
  "name": "tech-echo-collective",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "smoke:production": "node scripts/smoke-production.mjs",
    "backup:verify": "node scripts/verify-d1-export.mjs",
    "backup:snapshot:verify": "node scripts/verify-backup-json.mjs",
    "backup:snapshot:encrypt": "node scripts/backup-crypto.mjs encrypt",
    "backup:snapshot:decrypt": "node scripts/backup-crypto.mjs decrypt",
    "backup:snapshot:restore-sql": "node scripts/backup-json-to-sql.mjs",
    "backup:secrets:generate": "node scripts/generate-backup-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-server-dom-webpack": "19.2.8",
    "remark-gfm": "4.0.1",
    "vinext": "1.0.0-beta.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.0.18",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
